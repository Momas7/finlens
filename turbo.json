{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["API_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {},
    "test:integration": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_OWNER_URL",
        "TEST_DATABASE_ADMIN_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "WEB_ORIGIN",
        "API_URL",
        "PORT",
        "LOG_LEVEL",
        "NODE_ENV",
        "CI",
        "AUTH_RATE_LIMIT_PER_MINUTE"
      ]
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_OWNER_URL",
        "TEST_DATABASE_ADMIN_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "WEB_ORIGIN",
        "API_URL",
        "PORT",
        "LOG_LEVEL",
        "NODE_ENV",
        "CI",
        "AUTH_RATE_LIMIT_PER_MINUTE"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_OWNER_URL",
        "TEST_DATABASE_ADMIN_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "WEB_ORIGIN",
        "API_URL",
        "PORT",
        "LOG_LEVEL",
        "NODE_ENV",
        "CI",
        "AUTH_RATE_LIMIT_PER_MINUTE"
      ]
    }
  }
}
