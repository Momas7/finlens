# Banco (senhas de desenvolvimento, inseguras)
DATABASE_URL=postgres://finlens_app:finlens_app@localhost:5432/finlens
DATABASE_OWNER_URL=postgres://finlens_owner:finlens_owner@localhost:5432/finlens
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres

# Auth — gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# API
API_URL=http://localhost:3333
PORT=3333
LOG_LEVEL=info
AUTH_RATE_LIMIT_PER_MINUTE=10
# Requisições por minuto por IP em todas as rotas (atrás do Next, todos os usuários dividem um IP)
RATE_LIMIT_PER_MINUTE=300
# Proxies cujo X-Forwarded-For é aceito (IPs ou CIDRs, separados por vírgula).
# Deixe vazio, a não ser que haja um proxy reverso (nginx, Caddy) na frente que SOBRESCREVA
# o X-Forwarded-For: o Next.js repassa o cabeçalho enviado pelo cliente sem alterar.
TRUSTED_PROXIES=

# IA local opcional (último recurso na Revisão, só ao clicar em "Sugerir com IA").
# Qualquer servidor compatível com /chat/completions da OpenAI (Ollama, llama.cpp, LM Studio).
# Deixe LLM_BASE_URL vazio para desligar. Com servidor remoto, o texto da descrição sai da máquina.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
